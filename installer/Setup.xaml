<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音轨分离安装程序" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#DAD8D2"
        Foreground="#202322" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#202322"/>
            <Setter Property="Background" Value="#EEEBE2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Margin="3,5,3,1" CornerRadius="7" Background="#9A968A">
                                <Border.Effect><DropShadowEffect Direction="285" ShadowDepth="2" BlurRadius="4" Opacity=".25"/></Border.Effect>
                            </Border>
                            <Border x:Name="Cap" Margin="2,1,2,5" CornerRadius="7" Background="{TemplateBinding Background}"
                                    BorderThickness="1,1,1,0" BorderBrush="#FCF9F0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <Border x:Name="FocusRing" Margin="6,5,6,9" CornerRadius="4"
                                    BorderBrush="#77796D" BorderThickness="1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cap" Property="Background" Value="#F7F4ED"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Cap" Property="Margin" Value="2,3,2,3"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Cap" Property="Opacity" Value=".52"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <Border CornerRadius="7" BorderBrush="#AAA79C" BorderThickness="1" Background="#E9E6DE" Padding="14">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="6" Background="#313431" Margin="0,0,13,0">
                    <Path Fill="#E6E8E7" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,8 H3 V16 H0 Z M5,3 H8 V21 H5 Z M10,0 H13 V24 H10 Z M15,6 H18 V18 H15 Z"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="音轨分离" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionLabel" Foreground="#565D59" FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Margin="0,12,0,0" CornerRadius="7" BorderBrush="#343837" BorderThickness="2"
                Background="#17191B" Padding="16">
            <StackPanel>
                <TextBlock x:Name="Stage" Foreground="#E6E8E7" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="Detail" Margin="0,9,0,0" Foreground="#B7BEC0" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Progress" Height="5" Margin="0,14,0,0" Foreground="#D89058"
                             Background="#343837" Visibility="Collapsed" Maximum="6"/>
            </StackPanel>
        </Border>
        <StackPanel x:Name="Options" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Destination" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" x:Name="Browse" Content="选择安装路径"/>
            </Grid>
            <CheckBox x:Name="UseCuda" Content="使用 NVIDIA CUDA 12.8 加速" Margin="4,9,0,0"/>
            <CheckBox x:Name="DownloadModels" Content="准备全部本地模型" IsChecked="True" Margin="4,9,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="Cancel" Content="取消"/>
            <Button x:Name="Primary" Content="安装" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
